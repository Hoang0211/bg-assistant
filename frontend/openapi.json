            ],
            "title": "Max Players"
          },
          "min_age": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Age"
          },
          "min_play_time_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Play Time Minutes"
          },
          "max_play_time_minutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Play Time Minutes"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer",
                "description": "Year of first publication."
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Genres",
            "description": "Genres, stored trimmed, lowercased and without duplicates.",
            "default": []
          },
          "publisher": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Publisher"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "id",
          "created_at",
          "updated_at"
        ],
        "title": "GameRead",
        "description": "A game as returned by the API."
      },
      "GameUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "is_expansion": {
            "anyOf": [
              {
                "type": "boolean",
                "description": "Whether this game is an expansion of another game."
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Expansion"
          },
          "base_game_id": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The base game this expansion belongs to; only for expansions, and null while the base game isn't in the library."
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Game Id"
          },
          "min_players": {
