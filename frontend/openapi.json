            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "is_expansion": {
            "type": "boolean",
            "title": "Is Expansion",
            "description": "Whether this game is an expansion of another game.",
            "default": false
          },
          "base_game_id": {
            "anyOf": [
              {
                "type": "integer",
